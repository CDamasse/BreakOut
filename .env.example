APP_NAME=BreakOut
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.railway.app

LOG_CHANNEL=stack

# --- Variables fournies automatiquement par le plugin MySQL de Railway ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=breakout
DB_USERNAME=
